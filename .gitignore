# ============================================================================
#  RS-PU v4 — STM32H747 dual-core (CM4 + CM7), Keil MDK 5, VS Code + Keil Assistant
#  Корень репозитория:  ...\RS-PU_v4\RS-PU_v4
#  Все пути ниже — относительно этого каталога.
#
#  ВНИМАНИЕ: git не поддерживает комментарии в конце строки-шаблона —
#  комментарий должен занимать отдельную строку.
# ============================================================================

# ---------------------------------------------------------------------------
#  Keil: продукты сборки.
#  Каталоги целей создаются заново при Build. Из них в репозиторий попадает
#  ТОЛЬКО готовый .hex — его коммитим.
# ---------------------------------------------------------------------------
/MDK-ARM/pu_new_CM4/*
!/MDK-ARM/pu_new_CM4/*.hex
/MDK-ARM/pu_new_CM7/*
!/MDK-ARM/pu_new_CM7/*.hex

# BinKeil_CM7_CM4/ содержит только .hex — коммитится целиком, не исключаем.

# ---------------------------------------------------------------------------
#  Keil: пользовательские и временные файлы проекта
# ---------------------------------------------------------------------------
# c_cpp_properties.json, uv4.log, keil-assistant.log — генерируются расширением
/MDK-ARM/.vscode/
# раскладка окон uVision, привязана к пользователю Windows
/MDK-ARM/*.uvguix.*
/MDK-ARM/*.uvprojx.orig.bak
/MDK-ARM/*.uvprojx.bak_restructure
/MDK-ARM/*.uvprojx.template
# build_cm*.log, flash_*.log, fix_*.log
/MDK-ARM/*.log
# снимок командной строки от CubeMX, ни одним скриптом не запускается
/MDK-ARM/pu_new_CM4.BAT

# ВНИМАНИЕ: MDK-ARM/pu_new.uvprojx, MDK-ARM/pu_new.uvoptx, MDK-ARM/startup_*.s,
# активные MDK-ARM/*.sct, MDK-ARM/*.s.template, MDK-ARM/DebugConfig/,
# MDK-ARM/RTE/, MDK-ARM/EventRecorderStub.scvd — ОСТАЮТСЯ в репозитории.
# Без .uvprojx и .uvoptx проект не открывается и не собирается "из коробки".

# ---------------------------------------------------------------------------
#  CMSIS DSP — проектом не используется (в pu_new.uvprojx нет ни arm_math,
#  ни DSP-библиотек). ~176 МБ балласта: примеры, тесты, Python-обёртка,
#  исходники функций и готовые .lib/.a для ARM/IAR/GCC.
# ---------------------------------------------------------------------------
/Drivers/CMSIS/DSP/

# ---------------------------------------------------------------------------
#  VS Code
# ---------------------------------------------------------------------------
.vscode/

# ---------------------------------------------------------------------------
#  Мусор генератора CubeMX (GENERATE_CODE.cmd -> generate_and_fix.ps1)
#  Пересоздаётся при каждом запуске генерации.
# ---------------------------------------------------------------------------
/_gen*.txt
/gen*.txt
/*.txt.err

# ---------------------------------------------------------------------------
#  Страховка по расширениям (если такие файлы появятся позже)
# ---------------------------------------------------------------------------
*.uvguix.*
*.bak
*.orig
*.axf
*.elf
*.bin
*.o
*.d
*.lst
*.crf
*.dep
*.lnp
*.__i
*._ac
*.htm
*.tmp
*~
Thumbs.db
desktop.ini
*.hex
*.bin